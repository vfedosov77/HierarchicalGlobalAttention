[Unit]
Description=Qwen3.8-27B HGA llama-server backend (16 GB)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/hga-qwen38/api.env
# HGA_ROOT is this clone (set by deploy.py). Do not bake a host path in here.
WorkingDirectory=%h
ExecStart=/bin/bash -c 'cd "$HGA_ROOT" && exec "$HGA_ROOT/deployment/run-api.sh"'
Restart=on-failure
RestartSec=10
TimeoutStartSec=20min
TimeoutStopSec=90s
KillSignal=SIGTERM
LimitNOFILE=65536
StandardOutput=append:%h/.config/hga-qwen38/server.log
StandardError=append:%h/.config/hga-qwen38/server.log

[Install]
WantedBy=default.target
