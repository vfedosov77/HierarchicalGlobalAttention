[Unit]
Description=HGA Qwen OpenAI API profile gateway
After=hga-qwen38.service
Wants=hga-qwen38.service

[Service]
Type=simple
EnvironmentFile=%h/.config/hga-qwen38/api.env
# HGA_ROOT / HGA_API_HOST / HGA_API_PORT come from api.env. python3 is PATH.
WorkingDirectory=%h
ExecStart=/bin/bash -c 'cd "$HGA_ROOT" && exec python3 "$HGA_ROOT/deployment/api_gateway.py" --host "$HGA_API_HOST" --port "$HGA_API_PORT"'
Restart=on-failure
RestartSec=3
TimeoutStopSec=30s
StandardOutput=append:%h/.config/hga-qwen38/gateway.log
StandardError=append:%h/.config/hga-qwen38/gateway.log

[Install]
WantedBy=default.target
