{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "hga-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "local Qwen HGA (16 GB)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "{file:/home/YOU/.config/hga-qwen38/api-key}"
      },
      "models": {
        "qwen3.8-27b-hga": {
          "name": "local Qwen3.8-27B HGA",
          "reasoning": true,
          "interleaved": { "field": "reasoning_content" },
          "limit": { "context": 262144, "output": 262144 },
          "body": {
            "chat_template_kwargs": { "enable_thinking": true },
            "thinking_budget_tokens": 512,
            "max_tokens": 262144
          },
          "variants": {
            "fast": {
              "body": {
                "chat_template_kwargs": { "enable_thinking": false },
                "max_tokens": 262144
              }
            },
            "normal": {
              "body": {
                "chat_template_kwargs": { "enable_thinking": true },
                "thinking_budget_tokens": 512,
                "max_tokens": 262144
              }
            },
            "deep": {
              "body": {
                "chat_template_kwargs": { "enable_thinking": true },
                "thinking_budget_tokens": 4096,
                "max_tokens": 262144
              }
            }
          }
        },
        "qwen3.8-27b-hga-fast": {
          "name": "local Qwen3.8-27B HGA (fast)",
          "reasoning": false,
          "limit": { "context": 262144, "output": 262144 }
        },
        "qwen3.8-27b-hga-normal": {
          "name": "local Qwen3.8-27B HGA (normal reasoning)",
          "reasoning": true,
          "interleaved": { "field": "reasoning_content" },
          "limit": { "context": 262144, "output": 262144 }
        },
        "qwen3.8-27b-hga-deep": {
          "name": "local Qwen3.8-27B HGA (deep reasoning)",
          "reasoning": true,
          "interleaved": { "field": "reasoning_content" },
          "limit": { "context": 262144, "output": 262144 }
        }
      }
    }
  },
  "model": "hga-local/qwen3.8-27b-hga-fast"
}
